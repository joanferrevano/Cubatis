			float layerScale = scale;

			scale /= 1 + (_OutlineSoftness * _ScaleRatioA * scale);
			float bias = (0.5 - weight) * scale - 0.5;
			const float outline = _OutlineWidth * _ScaleRatioA * 0.5 * scale;

